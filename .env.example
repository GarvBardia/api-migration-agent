# ---- Postgres ----
POSTGRES_USER=migration_agent
POSTGRES_PASSWORD=migration_agent
POSTGRES_DB=migration_agent
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://migration_agent:migration_agent@localhost:5432/migration_agent

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- Backend ----
BACKEND_PORT=8000

# ---- LLM / embeddings ----
# Migration Agent (Step 4) provider selection -- config-driven, never a code
# change (see CLAUDE.md §4.3). 'claude' is the documented production-mode
# default; 'openrouter' is a genuine free-tier alternative for dev/testing.
MIGRATION_LLM_PROVIDER=claude        # claude | openrouter
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENROUTER_API_KEY=
MIGRATION_LLM_MODEL=                 # e.g. cohere/north-mini-code:free -- check
                                      # openrouter.ai/models for current free,
                                      # tool-calling-capable options; the free
                                      # list rotates.
# Step 10 (added 2026-08-27): no OpenAI/Voyage key configured, so the
# semantic cache (app/agents/semantic_cache.py) defaults to a free,
# locally-run model (sentence-transformers' all-MiniLM-L6-v2, 384-dim,
# confirmed empirically -- see CLAUDE.md §4.12) instead of blocking on an
# API key. OPENAI_API_KEY/VOYAGE_API_KEY are unused unless that's swapped
# back to a hosted embedding provider (would also need re-resizing
# api_doc_chunks.embedding via a new migration to match the new dimension).
EMBEDDING_PROVIDER=local              # local | openai | voyage
OPENAI_API_KEY=
VOYAGE_API_KEY=
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
SEMANTIC_CACHE_MAX_INDEX_SIZE=500

# ---- GitHub ----
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# ---- Sandbox ----
# DOCKER_HOST -- now actually load-bearing (containerization session,
# 2026-08-27): celery-worker (docker-compose.yml) mounts the host socket at
# this exact path, so this correctly points `docker` (running inside that
# container) at the mounted socket. On the HOST (running tests/uvicorn/
# celery directly via the venv, not containerized), validation.py's
# run_pytest_in_sandbox strips DOCKER_HOST from its subprocess call
# regardless of what's set here (Step 8a's fix) -- so this value is safe to
# leave set even when running on the host: it does nothing there, and is
# exactly correct inside celery-worker.
DOCKER_HOST=unix:///var/run/docker.sock
# SANDBOX_IMAGE must have pytest + pytest-json-report preinstalled --
# containers run with --network none, so nothing can be pip-installed at
# run time. Build the image once with:
#   docker build -t migration-agent-sandbox:latest backend/sandbox
SANDBOX_IMAGE=migration-agent-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1

# Docker-in-Docker path translation (containerization session, 2026-08-27)
# -- ONLY meaningful for celery-worker, the one service that both runs
# inside a container AND shells out to `docker run` against the HOST
# daemon (via the socket mount above) to launch sandbox containers as
# siblings. That daemon resolves `docker run -v <src>:<dst>` sources
# against ITS OWN filesystem (the host's), not celery-worker's -- so a
# temp dir created inside celery-worker (e.g. via tempfile.mkdtemp()) is
# invisible to it unless translated. See app/agents/validation.py's
# _host_visible_path and CLAUDE.md's dated note for the full story.
# SANDBOX_CONTAINER_TMP_DIR is set directly in docker-compose.yml for
# celery-worker (always /sandbox_tmp, not machine-specific). This value,
# SANDBOX_HOST_TMP_DIR, IS machine-specific -- set it to the absolute HOST
# path to this repo's backend/.sandbox_tmp directory (the bind-mount
# source for celery-worker's /sandbox_tmp). Left blank here (both unset in
# combination means no translation happens, i.e. host-run dev/tests are
# unaffected) -- must be set in your own .env before running the
# containerized stack.
SANDBOX_HOST_TMP_DIR=

# ---- Orchestrator ----
MAX_RETRIES_PER_FILE=3
CONFIDENCE_THRESHOLD=0.8

# Step 6b: crash-resume / dead-task detection (app/agents/resume.py).
STALENESS_WINDOW_SECONDS=300
MAX_SWEEP_ATTEMPTS=3
RESUME_SWEEP_INTERVAL_SECONDS=60

# ---- Saved repos / scheduled auto-checking / webhook notifications ----
# Added 2026-09-16, explicitly BEYOND the original 10-step plan (see
# CLAUDE.md's dated note). AUTO_CHECK_SWEEP_INTERVAL_SECONDS: how often
# Celery Beat ticks the auto-check sweep (app/tasks.py's
# periodic_auto_check_sweep) -- each repo's own check_interval_hours is
# the real gate on how often it's actually acted on.
AUTO_CHECK_SWEEP_INTERVAL_SECONDS=300

# NOTIFICATION_WEBHOOK_URL: optional. When unset, webhook notifications
# (app/agents/notifications.py) are silently skipped -- not an error, not
# even a log line. When set, a POST fires on a run reaching
# completed/failed and on any file landing in needs_review. Payload shape
# is {"text": "<message>"} -- the shape Slack/Discord incoming webhooks
# expect for a plain message, so a free Slack or Discord webhook URL
# works here directly with no adapter needed.
NOTIFICATION_WEBHOOK_URL=
